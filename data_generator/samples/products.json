  "human_review_rules": [
    {
      "code": "HR_HIGH_OUTPATIENT_AMOUNT",
      "condition": "outpatient claimed_amount >= 1000000"
    },
    {
      "code": "HR_HIGH_INPATIENT_AMOUNT",
      "condition": "inpatient claimed_amount >= 10000000"
    },
    {
      "code": "HR_REPEATED_SAME_DIAGNOSIS",
      "condition": "same diagnosis code claimed at least 3 times within 90 days"
    },
    {
      "code": "HR_MANUAL_THERAPY_FREQUENT",
      "condition": "manual therapy count is at least 20 within 180 days"
    },
    {
      "code": "HR_LATE_FIRST_TREATMENT",
      "condition": "days between incident date and first treatment date exceeds 30"
    },
    {
      "code": "HR_DOCUMENT_CLAIM_MISMATCH",
      "condition": "diagnosis, treatment, or document details do not match the claimed coverage"
    },
    {
      "code": "HR_ABNORMAL_DOCUMENT_DATES",
      "condition": "document issue date precedes treatment date or follows claim date abnormally"
    },
    {
      "code": "HR_DUPLICATE_RECEIPT",
      "condition": "receipt id has already been used"
    },
    {
      "code": "HR_HIGH_NONCOVERED_RATIO",
      "condition": "noncovered ratio is at least 80 percent and claimed amount is high"
    }
  ]
