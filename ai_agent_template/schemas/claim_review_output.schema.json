{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/claim_review_output.schema.json",
  "title": "Claim Review Output",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "recommended_decision",
    "recommended_payable_amount",
    "coverage_code",
    "coverage_name",
    "missing_documents",
    "reason_codes",
    "requires_human_review",
    "fraud_suspected",
    "confidence",
    "calculation",
    "policy_basis",
    "review_summary",
    "reviewer_notes"
  ],
  "properties": {
    "claim_id": { "type": "string", "minLength": 1 },
    "recommended_decision": {
      "type": "string",
      "enum": ["pay", "partial_pay", "request_documents", "deny", "human_review"]
    },
    "recommended_payable_amount": { "type": "integer", "minimum": 0 },
    "coverage_code": { "type": "string", "minLength": 1 },
    "coverage_name": { "type": "string", "minLength": 1 },
    "missing_documents": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires_human_review": { "type": "boolean" },
    "fraud_suspected": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score_source",
        "deterministic_confidence",
        "evidence_clarity",
        "judgment_difficulty",
        "uncertainty_level",
        "uncertainty_explanation",
        "assessment_basis"
      ],
      "properties": {
        "score_source": {
          "type": "string",
          "enum": ["deterministic_rules_with_llm_assistance"]
        },
        "deterministic_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_clarity": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "judgment_difficulty": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "uncertainty_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "uncertainty_explanation": { "type": "string", "minLength": 1 },
        "assessment_basis": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "maxItems": 5
        }
      }
    },
    "explanation_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "source",
        "faithfulness_to_tools",
        "citation_alignment",
        "calculation_alignment",
        "unsupported_claims_detected",
        "uncertainty_level",
        "validation_issues"
      ],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": {
          "type": "string",
          "enum": ["llm_output_validation"]
        },
        "faithfulness_to_tools": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "citation_alignment": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "calculation_alignment": {
          "type": "string",
          "enum": ["pass", "fail"]
        },
        "unsupported_claims_detected": { "type": "boolean" },
        "uncertainty_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "validation_issues": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 8
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed_amount",
        "eligible_amount",
        "limit_applied",
        "deductible_amount",
        "payable_amount"
      ],
      "properties": {
        "claimed_amount": { "type": "integer", "minimum": 0 },
        "eligible_amount": { "type": "integer", "minimum": 0 },
        "limit_applied": { "type": "boolean" },
        "deductible_amount": { "type": "integer", "minimum": 0 },
        "payable_amount": { "type": "integer", "minimum": 0 }
      }
    },
    "policy_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "section", "summary"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "chunk_id": { "type": "string" },
          "product_id": { "type": "string" },
          "product_version": { "type": "string" },
          "effective_date": { "type": "string", "format": "date" },
          "coverage_code": { "type": "string" },
          "clause_id": { "type": "string" },
          "citation_id": { "type": "string" },
          "retrieval_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "retrieval_method": {
            "type": "string",
            "enum": ["keyword", "vector", "hybrid", "structured"]
          }
        }
      }
    },
    "review_summary": { "type": "string", "minLength": 1 },
    "reviewer_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "specialist_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "agent_name",
          "agent_version",
          "status",
          "summary",
          "requires_human_review"
        ],
        "properties": {
          "agent_name": { "type": "string", "minLength": 1 },
          "agent_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "status": { "type": "string", "enum": ["success", "failed", "skipped"] },
          "summary": { "type": "string", "minLength": 1 },
          "requires_human_review": { "type": "boolean" },
          "reason_codes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "recommended_decision": { "const": "request_documents" } },
        "required": ["recommended_decision"]
      },
      "then": {
        "properties": { "missing_documents": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "requires_human_review": { "const": true } },
        "required": ["requires_human_review"]
      },
      "then": {
        "properties": { "recommended_decision": { "const": "human_review" } }
      }
    },
    {
      "if": {
        "properties": { "fraud_suspected": { "const": true } },
        "required": ["fraud_suspected"]
      },
      "then": {
        "properties": {
          "requires_human_review": { "const": true },
          "recommended_decision": { "const": "human_review" }
        }
      }
    }
  ]
}
