{
  "tool_name": "medical_review_causality",
  "version": "1.0.0",
  "description": "Assess medical necessity, diagnosis-treatment compatibility, pre-existing condition review needs, and excessive-treatment review needs.",
  "input_schema": {
    "type": "object",
    "required": ["claim", "insured_profile", "claim_history", "code_mapping"],
    "additionalProperties": false,
    "properties": {
      "claim": { "type": "object" },
      "insured_profile": { "type": "object" },
      "claim_history": { "type": "object" },
      "code_mapping": { "type": "object" },
      "medical_evidence": { "type": "object" },
      "document_extractions": { "type": "array", "items": { "type": "object" } }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "report",
      "normalized_kcd_code",
      "normalized_edi_code",
      "diagnosis_treatment_relationship",
      "medical_necessity",
      "recommended_medical_routing"
    ],
    "additionalProperties": false,
    "properties": {
      "report": { "$ref": "../../schemas/agent_report.schema.json" },
      "normalized_kcd_code": { "type": "string" },
      "normalized_edi_code": { "type": "string" },
      "diagnosis_treatment_relationship": {
        "type": "string",
        "enum": ["compatible", "weakly_related", "not_related", "unknown"]
      },
      "medical_necessity": {
        "type": "string",
        "enum": ["supported", "partially_supported", "unsupported", "insufficient_evidence"]
      },
      "pre_existing_condition_review": { "type": "boolean" },
      "excessive_treatment_review": { "type": "boolean" },
      "recommended_medical_routing": {
        "type": "string",
        "enum": ["continue_claim_review", "request_documents", "human_review"]
      }
    }
  },
  "timeout_ms": 5000,
  "failure_policy": "human_review",
  "owner": "claim-review-template"
}
