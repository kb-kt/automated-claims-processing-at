{
  "tool_name": "fraud_signal_checker",
  "version": "1.0.0",
  "description": "Detect duplicate receipt, fraudulent document, or abnormal token/hash/aggregate fraud signals.",
  "input_schema": {
    "type": "object",
    "required": ["claim", "claim_history", "signals", "insured_profile"],
    "properties": {
      "claim": { "type": "object" },
      "claim_history": { "type": "object" },
      "signals": { "type": "object" },
      "insured_profile": { "type": "object" }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["fraud_suspected", "fraud_reason_codes"],
    "properties": {
      "fraud_suspected": { "type": "boolean" },
      "fraud_reason_codes": {
        "type": "array",
        "items": { "type": "string" }
      },
      "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
      "routing": {
        "type": "string",
        "enum": ["human_review", "continue_claim_review"]
      },
      "requires_human_review": { "type": "boolean" },
      "engine_version": { "type": "string", "minLength": 1 },
      "workflow_version": { "type": "string", "minLength": 1 },
      "request_id": { "type": "string", "minLength": 1 },
      "document_findings": {
        "type": "array",
        "items": { "type": "object" }
      },
      "history_findings": {
        "type": "array",
        "items": { "type": "object" }
      },
      "evidence": {
        "type": "array",
        "items": { "type": "object" }
      },
      "analysis_warnings": {
        "type": "array",
        "items": { "type": "string" }
      },
      "tool_failures": {
        "type": "array",
        "items": { "type": "object" }
      }
    }
  },
  "timeout_ms": 3000,
  "failure_policy": "human_review",
  "owner": "claim-review-template"
}
