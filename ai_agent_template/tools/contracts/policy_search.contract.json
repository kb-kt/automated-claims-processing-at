{
  "tool_name": "policy_search",
  "version": "1.0.0",
  "description": "Search policy documents for coverage, exclusion, deductible, and human-review basis.",
  "input_schema": {
    "type": "object",
    "required": ["product_id", "query"],
    "additionalProperties": false,
    "properties": {
      "product_id": { "type": "string" },
      "query": { "type": "string" },
      "top_k": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
      "retrieval_mode": {
        "type": "string",
        "enum": ["keyword", "vector", "hybrid", "structured"],
        "default": "keyword"
      },
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_version": { "type": "string" },
          "effective_date": { "type": "string", "format": "date" },
          "coverage_code": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["matches"],
    "properties": {
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["section", "summary", "source"],
          "additionalProperties": false,
          "properties": {
            "chunk_id": { "type": "string" },
            "section": { "type": "string" },
            "summary": { "type": "string" },
            "source": { "type": "string" },
            "text": { "type": "string" },
            "product_id": { "type": "string" },
            "product_version": { "type": "string" },
            "effective_date": { "type": "string", "format": "date" },
            "coverage_code": { "type": "string" },
            "clause_id": { "type": "string" },
            "citation_id": { "type": "string" },
            "retrieval_score": { "type": "number", "minimum": 0, "maximum": 1 },
            "retrieval_method": {
              "type": "string",
              "enum": ["keyword", "vector", "hybrid", "structured"]
            }
          }
        }
      }
    }
  },
  "timeout_ms": 3000,
  "failure_policy": "human_review",
  "owner": "claim-review-template"
}
